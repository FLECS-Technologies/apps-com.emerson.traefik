
{
    "$schema": "https://raw.githubusercontent.com/FLECS-Technologies/app-sdk/main/manifest.schema.json",
    "_schemaVersion": "2.0.0",
    "app": "com.emerson.traefik",
    "version": "##VERSION##",
    "revision": "0",
    "image": "flecs.azurecr.io/com.emerson.traefik",
    "multiInstance": false,
    "editor": "",
    "args": [
        "--providers.docker=true",
        "--providers.docker.exposedbydefault=false",
        "--entrypoints.web.address=:80",
        "--entrypoints.web.transport.respondingTimeouts.readTimeout=1800",
        "--entrypoints.web.transport.respondingTimeouts.writeTimeout=1800",
        "--entrypoints.web.transport.respondingTimeouts.idleTimeout=1800",
        "--serverstransport.insecureskipverify=true"
    ],
    "capabilities": [],
    "conffiles": [],
    "devices": [],
    "hostname": "emerson-traefik",
    "env": [],
    "ports": [
        "127.0.0.1:40000:80"
    ],
    "volumes": [
        "/var/run/docker.sock:/var/run/docker.sock",
        "/etc/timezone:/etc/timezone",
        "/etc/localtime:/etc/localtime"
    ],
    "labels": [
        "traefik.enable=false"
    ]
}
